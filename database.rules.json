{
  "rules": {
    ".read": false,
    ".write": false,
    "registrations": {
      "$id": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'agent')",
        ".write": "(!data.exists() && newData.exists() && now <= 1788460199000 && newData.hasChildren(['teamName','event','members','leaderEmail','leaderPhone','createdAt']) && newData.child('members').numChildren() >= 1 && newData.child('members').numChildren() <= 5) || (auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'agent'))"
      }
    },
    "contacts": {
      "$ticket": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'agent')",
        ".write": "(!data.exists() && newData.exists() && newData.hasChildren(['ticket','name','email','subject','message','createdAt','status'])) || (auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'agent'))"
      }
    },
    "contactStatus": {
      "$ticket": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'agent') || (!data.exists() && newData.hasChildren(['status']))"
      }
    },
    "announcements": {
      "$id": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'author')"
      }
    },
    "results": {
      "$id": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'author')"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    }
  }
}
